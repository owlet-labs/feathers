spectral_fine --add spectral --set 1:Spectral_Resolution=2 --save test_-_Spectral_at_Fine_resolution --idle 0.05 --held 0.05 --tail 0.05
spectral_poly --add spectral --set 1:Spectral_Poly=1 --save test_-_Spectral_Poly_one_STFT_per_voice --idle 0.05 --held 0.05 --tail 0.05
spectral_vocode --add spectral --set 1:Spectral_Vocode=1 --save test_-_Spectral_Vocode_needs_a_sidechain --idle 0.05 --held 0.05 --tail 0.05
dense_v5 --add HARM --add OWLTT --add SHPR --add PHFL --add DISPERSE --add eq --add comp --add DELAY --add FVERB --add clip --add STEREO --save test_-_Dense_chain_of_11_devices_V5 --idle 0.05 --held 0.05 --tail 0.05
dense_add --engine additive --add HARM --add OWLTT --add SHPR --add PHFL --add DISPERSE --add eq --add comp --add DELAY --add FVERB --add clip --add STEREO --save test_-_Dense_chain_of_11_devices_Additive --idle 0.05 --held 0.05 --tail 0.05
mods_lane --add LFO --add LFO --add LFO --add LFO --add MSEG --add MSEG --add STEPSEQ --add SNH --add rtrig --add FOLLOWER --add MATH --add smth --save test_-_12_modulators_in_the_lane_unrouted --idle 0.05 --held 0.05 --tail 0.05
v5_16 --voice-count 16 --save test_-_16_voices_V5 --idle 0.05 --held 0.05 --tail 0.05
add_16 --engine additive --voice-count 16 --save test_-_16_voices_Additive --idle 0.05 --held 0.05 --tail 0.05
book_16 --preset presets/factory/Feathers/machine_elf_book_of_dreams.fpreset --voice-count 16 --save test_-_16_voices_Book_of_Dreams --idle 0.05 --held 0.05 --tail 0.05
v5_16_stack4 --voice-count 16 --param 0x65=4 --save test_-_16_voices_V5_stack_4 --idle 0.05 --held 0.05 --tail 0.05
add_16_stack4 --engine additive --voice-count 16 --param 0x65=4 --save test_-_16_voices_Additive_stack_4 --idle 0.05 --held 0.05 --tail 0.05
v5_16_stack8 --voice-count 16 --param 0x65=8 --save test_-_16_voices_V5_stack_8 --idle 0.05 --held 0.05 --tail 0.05
add_16_stack8 --engine additive --voice-count 16 --param 0x65=8 --save test_-_16_voices_Additive_stack_8 --idle 0.05 --held 0.05 --tail 0.05
baby_elf_bass_minus0 --preset presets/factory/Feathers/baby_elf_bass.fpreset --remove 0 --save test_-_Baby_Elf_Bass_without_Filter_1 --idle 0.05 --held 0.05 --tail 0.05
baby_elf_bass_minus1 --preset presets/factory/Feathers/baby_elf_bass.fpreset --remove 1 --save test_-_Baby_Elf_Bass_without_Smooth_Shaper --idle 0.05 --held 0.05 --tail 0.05
