# Schema ledger for busu (backlog JF, split per device by NY.1). Checked by tests/test_state_ledger.cpp, whose banner says what each
# difference means: a new line is pasted, a harmless change is refreshed (FEATHERS_LEDGER_WRITE=1), a MEANING change is a new key or a schema bump.
device busu - schema=1
param busu bus_enabled unit=choice choice=Off|On
param busu bus_gain unit=fader min=0 max=1 stepped=0
param busu bus_pan unit=percent min=-1 max=1 stepped=0
param busu bus_pan_l unit=percent min=-1 max=1 stepped=0
param busu bus_pan_r unit=percent min=-1 max=1 stepped=0
param busu bus_width unit=percent min=0 max=2 stepped=0
param busu bus_invert_l unit=choice choice=Off|On
param busu bus_invert_r unit=choice choice=Off|On
param busu bus_highpass unit=choice choice=Off|10Hz|20Hz|30Hz|50Hz|80Hz|120Hz
param busu bus_clip unit=choice choice=Off|Soft 100%|Soft 50%|Soft 25%|Soft 12%|Soft 6%|Soft 3%|Soft 1%|Hard
param busu bus_mix unit=percent min=0 max=1 stepped=0
param busu bus_wet_gain unit=fader min=0 max=1 stepped=0
param busu bus_mid_trim unit=decibel min=-12 max=12 stepped=0
param busu bus_side_trim unit=decibel min=-12 max=12 stepped=0
param busu bus_monitor unit=choice choice=Stereo|Mono|Left|Right|Side
param busu bus_swap unit=choice choice=Off|On
