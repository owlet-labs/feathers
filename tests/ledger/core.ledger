# Schema ledger for core (backlog JF, split per device by NY.1). Checked by tests/test_state_ledger.cpp, whose banner says what each
# difference means: a new line is pasted, a harmless change is refreshed (FEATHERS_LEDGER_WRITE=1), a MEANING change is a new key or a schema bump.
device core - schema=1
param core resonate.width unit=percent min=0 max=1 stepped=0
param core resonate.bow unit=factor min=0 max=4 stepped=0
param core resonate.bow_mode unit=choice choice=Laws|Triangle|StickSlip|Noise|Pulses|Walk
