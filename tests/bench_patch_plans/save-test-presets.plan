dev_FOLLOWER --add FOLLOWER --save test_-_Init_with_Follower --idle 0.05 --held 0.05 --tail 0.05
dev_RACK --add RACK --save test_-_Init_with_Rack --idle 0.05 --held 0.05 --tail 0.05
dev_inject --add inject --save test_-_Init_with_Sidechain_Inject --idle 0.05 --held 0.05 --tail 0.05
rack_mode1 --add RACK --set 1:Rack_Mode=1 --save test_-_Rack_in_Select_mode --idle 0.05 --held 0.05 --tail 0.05
rack_mode2 --add RACK --set 1:Rack_Mode=2 --save test_-_Rack_in_Blend_mode --idle 0.05 --held 0.05 --tail 0.05
