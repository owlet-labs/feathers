# THE DRUM ENGINE'S STARTER KITS (S9): saved once through the
# browser's road (bench_patch --save) under $FEATHERS_PRESET_ROOT/Feathers/Drums, tagged factory and drum. Run from the repo root,
# --rounds 1, then copy $FEATHERS_PRESET_ROOT/Feathers/Drums/*.fpreset to presets/factory/Feathers/Drums/. A pad's block is
# 0x0600 + slot·0x20 + control (Kind 0, Note 1, Choke 2, Voices 3, Trigger 4, Level 5, Pan 6, Tune 7, Decay 8 (log2 s),
# Release 9, Sweep Time 10, Drive 11, Claps 12, Spread 13, Velocity 14, then the scalers Pitch 15 .. Metal 21); Mode is 0xC8 and
# the Pitched Kind 0xC9. Each sets the strip envelope's Sustain to full with a long Release (s0), so a hit's own decay shapes it.
# The notes the plan plays are the kit's kick, snare and closed hat. Each kit is auditioned, then kept, renamed or dropped.
machine --engine drum --note 36 --step 2 --notes 3 --param 0x0608=-0.515 --param 0x060B=0.35 --param 0x0611=0.85 --param 0x0633=0.8 --param 0x0632=0.6 --param 0x0652=0.85 --param 0x0655=0.65 --param 0x0646=-0.35 --param 0x0666=0.35 --param 0x06F2=0.8 --param 0x06F5=0.6 --set s0:Env_Sustain=1 --set s0:Env_Release=1.0 --category Drums --tags factory,drum,kit --save Machine_Kit --idle 0.05 --held 0.05 --tail 0.05
wood --engine drum --note 36 --step 2 --notes 3 --param 0x0608=-1.5 --param 0x060B=0.0 --param 0x0611=0.6 --param 0x0614=0.7 --param 0x0633=0.65 --param 0x0632=0.5 --param 0x0634=0.7 --param 0x06A8=-0.15 --param 0x06C8=-0.3 --param 0x06E8=1.6 --param 0x06F5=0.8 --param 0x06F4=0.75 --set s0:Env_Sustain=1 --set s0:Env_Release=1.0 --category Drums --tags factory,drum,kit --save Wood_Kit --idle 0.05 --held 0.05 --tail 0.05
junk --engine drum --note 36 --step 2 --notes 3 --param 0x0620=3 --param 0x0635=0.9 --param 0x06A0=5 --param 0x06C0=5 --param 0x06A8=0.3 --param 0x06C8=0.0 --param 0x06B5=0.8 --param 0x06D5=0.6 --param 0x06F5=0.95 --param 0x06E8=2.0 --param 0x0675=0.9 --param 0x0655=0.85 --set s0:Env_Sustain=1 --set s0:Env_Release=1.0 --category Drums --tags factory,drum,kit --save Junkyard_Kit --idle 0.05 --held 0.05 --tail 0.05
walk --engine drum --note 36 --step 2 --notes 3 --param 0xCA=0.35 --param 0xCB=-0.2 --set s0:Env_Sustain=1 --set s0:Env_Release=1.0 --category Drums --tags factory,drum,kit --save Walking_Kit --idle 0.05 --held 0.05 --tail 0.05
toms --engine drum --note 48 --step 4 --notes 3 --param 0xC8=0 --param 0xC9=1 --param 0x0608=-0.3 --param 0x0611=0.45 --param 0x0614=0.6 --set s0:Env_Sustain=1 --set s0:Env_Release=1.0 --category Drums --tags factory,drum,pitched --save Tuned_Toms --idle 0.05 --held 0.05 --tail 0.05
bars --engine drum --note 60 --step 4 --notes 3 --param 0xC8=0 --param 0xC9=1 --param 0x0608=1.2 --param 0x0611=0.0 --param 0x0615=1.0 --param 0x0612=0.7 --add FVERB --set 1:Featherverb_Mix=0.25 --set s0:Env_Sustain=1 --set s0:Env_Release=1.0 --category Drums --tags factory,drum,pitched --save Bell_Bars --idle 0.05 --held 0.05 --tail 0.05
