# THE COMMIT A BUILD WAS MADE FROM, for the event log (src/plugin/event_log.h) — run as a SCRIPT at every
# build (`cmake -P`), not at configure, because the permanent install dir is configured once and built for
# months: a configure-time stamp would name the commit it was configured at, forever.
#
# Inputs: SOURCE_DIR, OUTPUT. Writes `#define FEATHERS_BUILD_SHA "<describe>"` and touches the file only
# when the text changes, so an unchanged commit recompiles nothing. `--dirty` costs ~0.3 s a build here and
# is what says a build carried uncommitted edits.
#
# CI (.github/workflows/build.yml): actions/checkout fetches ONE commit (fetch-depth 1), which `describe
# --always` still names — by its abbreviated sha, or by the tag when the run was a tag push. If git cannot
# answer at all (no git, or a checkout git refuses as "dubious ownership"), the runner's GITHUB_SHA does.
# A tree that is neither stamps "unknown".
execute_process(COMMAND git -C "${SOURCE_DIR}" describe --always --dirty --abbrev=12
	OUTPUT_VARIABLE _sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0 OR NOT _sha)
	if(DEFINED ENV{GITHUB_SHA} AND NOT "$ENV{GITHUB_SHA}" STREQUAL "")
		string(SUBSTRING "$ENV{GITHUB_SHA}" 0 12 _sha)
	else()
		set(_sha "unknown")
	endif()
endif()
set(_text "// Generated by cmake/BuildStamp.cmake at build time. Do not edit.\n#pragma once\n#define FEATHERS_BUILD_SHA \"${_sha}\"\n")
if(EXISTS "${OUTPUT}")
	file(READ "${OUTPUT}" _old)
else()
	set(_old "")
endif()
if(NOT _old STREQUAL _text)
	file(WRITE "${OUTPUT}" "${_text}")
endif()
