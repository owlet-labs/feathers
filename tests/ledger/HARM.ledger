# Schema ledger for HARM (backlog JF, split per device by NY.1). Checked by tests/test_state_ledger.cpp, whose banner says what each
# difference means: a new line is pasted, a harmless change is refreshed (FEATHERS_LEDGER_WRITE=1), a MEANING change is a new key or a schema bump.
device HARM - schema=1
param HARM harm_enabled unit=choice choice=Off|On
param HARM harm_harmonic unit=number min=0 max=101 stepped=1
param HARM harm_level unit=percent min=0 max=1 stepped=0
param HARM harm_fine unit=number min=-12 max=12 stepped=0
param HARM harm_phase unit=percent min=0 max=1 stepped=0
param HARM harm_spread unit=percent min=0 max=1 stepped=0
param HARM harm_attack unit=log_seconds min=-11 max=3.3219280948873626 stepped=0
param HARM harm_release unit=log_seconds min=-11 max=3.3219280948873626 stepped=0
param HARM harm_width unit=percent min=0 max=1 stepped=0
param HARM harm_depth unit=percent min=0 max=1 stepped=0
param HARM harm_porta unit=log_seconds min=-11 max=3.3219280948873626 stepped=0
param HARM harm_poly unit=choice choice=Off|On
param HARM harm_depth_env unit=choice choice=Off|On
param HARM harm_mode unit=choice choice=Notch|High-pass
param HARM harm_mix unit=percent min=0 max=1 stepped=0
param HARM harm_wet_gain unit=fader min=0 max=1 stepped=0
