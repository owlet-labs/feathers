# Turns THIRD-PARTY-NOTICES.md's "Required credits, in one place" into a C++ header (backlog LG).
#
# The About part of the settings screen shows the lines the licences ask for. Copying them into C++ by
# hand would make a second source that drifts from what ships; generating them means the screen says
# exactly what the notices file says, and a credit added there reaches the screen at the next build.
#
# Each top-level bullet ("- ...", continued on indented lines) becomes ONE string, its line breaks
# folded to spaces. The section ends at the next "## " heading. A semicolon is parked as a sentinel while
# the bullets are a CMake list, which would otherwise split a credit at it.
#
# Run as `cmake -DNOTICES=<file> -DHEADER=<file> -P GenerateCredits.cmake`.

if(NOT DEFINED NOTICES OR NOT DEFINED HEADER)
	message(FATAL_ERROR "NOTICES and HEADER are both required")
endif()

file(READ ${NOTICES} TEXT)
string(REGEX MATCH "## Required credits[^\n]*\n(.*)" _ "${TEXT}")
set(SECTION "${CMAKE_MATCH_1}")
string(FIND "${SECTION}" "\n## " END)
if(END GREATER -1)
	string(SUBSTRING "${SECTION}" 0 ${END} SECTION)
endif()

# Fold each continuation line onto its bullet, then cut at the bullets.
string(REGEX REPLACE "\n[ \t]+" " " SECTION "${SECTION}")
string(REPLACE "\\" "\\\\" SECTION "${SECTION}")
string(REPLACE "\"" "\\\"" SECTION "${SECTION}")
string(REPLACE ";" "@SEMICOLON@" SECTION "${SECTION}")
string(REGEX MATCHALL "\n- [^\n]*" BULLETS "\n${SECTION}")

set(BODY "")
set(COUNT 0)
foreach(BULLET IN LISTS BULLETS)
	string(REGEX REPLACE "^\n- " "" BULLET "${BULLET}")
	string(REPLACE "@SEMICOLON@" ";" BULLET "${BULLET}")
	string(APPEND BODY "\t\"${BULLET}\",\n")
	math(EXPR COUNT "${COUNT} + 1")
endforeach()
if(COUNT EQUAL 0)
	message(FATAL_ERROR "no \"Required credits\" bullets in ${NOTICES} — has the notices file been restructured?")
endif()

set(OUT "// Generated by cmake/GenerateCredits.cmake from THIRD-PARTY-NOTICES.md. Do not edit.\n")
string(APPEND OUT "#pragma once\n\nnamespace feathers::credits {\n\ninline constexpr const char* kRequired[] = {\n")
string(APPEND OUT "${BODY}")
string(APPEND OUT "};\n\n} // namespace feathers::credits\n")

if(EXISTS ${HEADER})
	file(READ ${HEADER} OLD)
else()
	set(OLD "")
endif()
if(NOT OLD STREQUAL OUT)
	file(WRITE ${HEADER} "${OUT}")
endif()
