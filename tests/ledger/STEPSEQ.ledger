# Schema ledger for STEPSEQ (backlog JF, split per device by NY.1). Checked by tests/test_state_ledger.cpp, whose banner says what each
# difference means: a new line is pasted, a harmless change is refreshed (FEATHERS_LEDGER_WRITE=1), a MEANING change is a new key or a schema bump.
device STEPSEQ - schema=1
param STEPSEQ steps unit=number min=1 max=32 stepped=1
param STEPSEQ direction unit=choice choice=Forward|Backward|Ping-Pong|Random|Random Walk
param STEPSEQ clock unit=choice choice=Rate|Trig
param STEPSEQ time_base unit=choice choice=Hz|1/64|1/64.|1/64T|1/32|1/32.|1/32T|1/16|1/16.|1/16T|1/8|1/8.|1/8T|1/4|1/4.|1/4T|1/2|1/2.|1/2T|1 bar|1 bar.|1 barT|2 bar|2 bar.|2 barT|4 bar|4 bar.|4 barT
param STEPSEQ rate unit=log_multiple min=-11 max=3.321928024291992 stepped=0
param STEPSEQ gate_length unit=percent min=0 max=1 stepped=0
param STEPSEQ retrig unit=choice choice=Off|On
param STEPSEQ poly unit=choice choice=Off|On
param STEPSEQ bipolar unit=choice choice=Off|On
param STEPSEQ seed unit=number min=0 max=999 stepped=1
param STEPSEQ random_amount unit=percent min=0 max=1 stepped=0
param STEPSEQ turing unit=choice choice=Off|On
param STEPSEQ turing_lock unit=percent min=0 max=1 stepped=0
param STEPSEQ enabled unit=choice choice=Off|On
param STEPSEQ trig unit=percent min=0 max=1 stepped=0
param STEPSEQ reset unit=percent min=0 max=1 stepped=0
param STEPSEQ amount unit=percent min=-1 max=1 stepped=0
param STEPSEQ rand_value unit=percent min=0 max=1 stepped=0
param STEPSEQ rand_gate unit=percent min=0 max=1 stepped=0
param STEPSEQ rand_prob unit=percent min=0 max=1 stepped=0
param STEPSEQ rand_ratchet unit=percent min=0 max=1 stepped=0
param STEPSEQ rand_slew unit=percent min=0 max=1 stepped=0
extra STEPSEQ steps_pattern floats=66
block STEPSEQ steps_play floats=47
out STEPSEQ value bipolar=1
out STEPSEQ gate bipolar=0
out STEPSEQ trigger bipolar=0
