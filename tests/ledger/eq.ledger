# Schema ledger for eq (backlog JF, split per device by NY.1). Checked by tests/test_state_ledger.cpp, whose banner says what each
# difference means: a new line is pasted, a harmless change is refreshed (FEATHERS_LEDGER_WRITE=1), a MEANING change is a new key or a schema bump.
device eq - schema=1
param eq enabled unit=choice choice=Off|On
param eq offset unit=number min=-10 max=10 stepped=0
param eq amount unit=percent min=-2 max=2 stepped=0
param eq tilt unit=number min=-6 max=6 stepped=0
param eq tilt_pivot unit=log_hertz min=6.643856189774725 max=13.28771237954945 stepped=0
param eq output unit=decibel min=-24 max=24 stepped=0
param eq phase unit=choice choice=Minimum|Linear
param eq key_track unit=choice choice=Off|On
param eq eq_mix unit=percent min=0 max=1 stepped=0
param eq eq_wet_gain unit=fader min=0 max=1 stepped=0
param eq b1_on unit=choice choice=Off|On
param eq b1_type unit=choice choice=Bell|Low Shelf|High Shelf|Low Cut|High Cut|Notch
param eq b1_freq unit=log_hertz min=4.321928094887363 max=14.287712379549449 stepped=0
param eq b1_gain unit=decibel min=-24 max=24 stepped=0
param eq b1_q unit=number min=-3.321928094887362 max=4.169925001442312 stepped=0
param eq b1_slope unit=choice choice=6 dB|12 dB|18 dB|24 dB|36 dB|48 dB|72 dB|96 dB
