# Schema ledger for balance (backlog JF, split per device by NY.1). Checked by tests/test_state_ledger.cpp, whose banner says what each
# difference means: a new line is pasted, a harmless change is refreshed (FEATHERS_LEDGER_WRITE=1), a MEANING change is a new key or a schema bump.
device balance - schema=1
param balance balance_enabled unit=choice choice=Off|On
param balance balance_bands unit=choice choice=2 bands|3 bands
param balance balance_spacing unit=number min=20 max=2000 stepped=0
param balance balance_spacing2 unit=number min=200 max=20000 stepped=0
param balance balance_key_track unit=choice choice=Off|On
param balance balance_sharp unit=choice choice=Off|On
param balance balance_strength unit=percent min=0 max=1 stepped=0
param balance balance_attack unit=log_seconds min=-6.643856189774724 max=2.321928094887362 stepped=0
param balance balance_release unit=log_seconds min=-4.321928094887362 max=3.321928094887362 stepped=0
param balance balance_pan unit=percent min=-1 max=1 stepped=0
param balance balance_hp_wet unit=log_hertz min=4.321928094887362 max=12.965784284662087 stepped=0
param balance balance_sub_thru unit=choice choice=Off|On
param balance balance_mix unit=percent min=0 max=1 stepped=0
param balance balance_wet_gain unit=fader min=0 max=1 stepped=0
