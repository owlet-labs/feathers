dev_eq --add eq --save test_-_Init_with_EQ --idle 0.05 --held 0.05 --tail 0.05
dev_DISPERSE --add DISPERSE --save test_-_Init_with_Disperser --idle 0.05 --held 0.05 --tail 0.05
