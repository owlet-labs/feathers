# THE TEST PRESETS: every survey patch that is not already a factory preset, saved once through the browser's road
# (bench_patch --save) under $FEATHERS_PRESET_ROOT/Feathers/Test, tagged test. Run from the repo root, --rounds 1, then
# copy $FEATHERS_PRESET_ROOT/Feathers/Test/*.fpreset to presets/factory/Feathers/Test/. Host automation, note counts and a
# sidechain are not patch state, so the automated-Pos-X and note-count rows of the other plans have no preset of their own.
init_add --engine additive --save test_-_Init_on_Additive --idle 0.05 --held 0.05 --tail 0.05
dev_flt1 --add flt1 --save test_-_Init_with_Filter --idle 0.05 --held 0.05 --tail 0.05
dev_HARM --add HARM --save test_-_Init_with_Harm --idle 0.05 --held 0.05 --tail 0.05
dev_OWLTT --add OWLTT --save test_-_Init_with_OWLTT --idle 0.05 --held 0.05 --tail 0.05
