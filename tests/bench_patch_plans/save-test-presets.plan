dev_LFO --add LFO --save test_-_Init_with_LFO --idle 0.05 --held 0.05 --tail 0.05
dev_DELAY --add DELAY --save test_-_Init_with_Delay --idle 0.05 --held 0.05 --tail 0.05
dev_PITCH --add PITCH --save test_-_Init_with_Pitch --idle 0.05 --held 0.05 --tail 0.05
dev_ERODER --add ERODER --save test_-_Init_with_Eroder --idle 0.05 --held 0.05 --tail 0.05
