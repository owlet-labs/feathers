# Schema ledger for MACRO1 (backlog JF, split per device by NY.1). Checked by tests/test_state_ledger.cpp, whose banner says what each
# difference means: a new line is pasted, a harmless change is refreshed (FEATHERS_LEDGER_WRITE=1), a MEANING change is a new key or a schema bump.
device MACRO1 - schema=1
param MACRO1 macro_1 unit=percent min=0 max=1 stepped=0
param MACRO1 bipolar_1 unit=choice choice=Off|On
param MACRO1 type_1 unit=choice choice=Knob|Latch|Momentary
param MACRO1 enabled unit=choice choice=Off|On
out MACRO1 macro_1 bipolar=1
