param DRUM drum_clap_hp unit=log_hertz min=4.321928094887363 max=11 stepped=0
param DRUM drum_wire_decay unit=log_seconds min=-6.643856189774724 max=1 stepped=0
param DRUM drum_click_decay unit=log_seconds min=-9.965784284662087 max=-4.321928094887363 stepped=0
param DRUM drum_wire_contour unit=choice choice=Exp|Linear|Mod
