# Schema ledger for DHDS (backlog JF, split per device by NY.1). Checked by tests/test_state_ledger.cpp, whose banner says what each
# difference means: a new line is pasted, a harmless change is refreshed (FEATHERS_LEDGER_WRITE=1), a MEANING change is a new key or a schema bump.
device DHDS - schema=1
param DHDS env_delay unit=log_seconds min=-11 max=3.321928024291992 stepped=0
param DHDS env_attack unit=log_seconds min=-11 max=3.321928024291992 stepped=0
param DHDS env_hold unit=log_seconds min=-11 max=3.321928024291992 stepped=0
param DHDS env_decay unit=log_seconds min=-11 max=3.321928024291992 stepped=0
param DHDS env_sustain unit=percent min=0 max=1 stepped=0
param DHDS env_release unit=log_seconds min=-11 max=3.321928024291992 stepped=0
param DHDS env_attack_curve unit=percent min=-1 max=1 stepped=0
param DHDS env_decay_curve unit=percent min=-1 max=1 stepped=0
param DHDS env_release_curve unit=percent min=-1 max=1 stepped=0
param DHDS env_smoothing unit=log_seconds min=-11 max=0 stepped=0
param DHDS env_mode unit=choice choice=Gate|Loop|Once|Free|LFO Retrig
param DHDS env_legato unit=choice choice=Off|On
param DHDS env_bipolar unit=choice choice=Off|On
param DHDS env_enabled unit=choice choice=Off|On
param DHDS env_amount unit=percent min=-1 max=1 stepped=0
param DHDS env_poly unit=choice choice=Off|On
param DHDS env_smooth_carry unit=choice choice=Off|On
param DHDS env_trig unit=percent min=0 max=1 stepped=0
param DHDS env_notes_trig unit=choice choice=Off|On
out DHDS envelope bipolar=1
