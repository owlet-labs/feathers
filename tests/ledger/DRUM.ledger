param DRUM drum_f_pitch unit=percent min=0 max=1 stepped=0
param DRUM drum_f_length unit=percent min=0 max=1 stepped=0
param DRUM drum_f_sweep unit=percent min=0 max=1 stepped=0
param DRUM drum_f_snap unit=percent min=0 max=1 stepped=0
param DRUM drum_f_metal unit=percent min=0 max=1 stepped=0
param DRUM drum_sweep_time unit=log_seconds min=-7.643856189774724 max=-1 stepped=0
param DRUM drum_drive_curve unit=choice choice=Tanh|Tube|Soft Clip
param DRUM drum_drive_tone unit=percent min=0 max=1 stepped=0
