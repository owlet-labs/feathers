# Schema ledger for PAT (backlog JF, split per device by NY.1). Checked by tests/test_state_ledger.cpp, whose banner says what each
# difference means: a new line is pasted, a harmless change is refreshed (FEATHERS_LEDGER_WRITE=1), a MEANING change is a new key or a schema bump.
device PAT - schema=1
param PAT enabled unit=choice choice=Off|On
param PAT selector unit=percent min=0 max=1 stepped=0
param PAT keys unit=choice choice=Transpose|Pool
param PAT latch unit=choice choice=Off|On
param PAT humanize unit=choice choice=Straight|Swing 4|Swing 8|Swing 16|Groove 4|Groove 8|Groove 16|Free 4|Free 8|Free 16|Tight|Loose|Drunk|Push|Lazy|Strum Up|Strum Down|Flam
param PAT humanize_amount unit=percent min=0 max=1 stepped=0
param PAT seed unit=number min=0 max=999 stepped=1
param PAT offset unit=number min=-16 max=16 stepped=1
param PAT nudge unit=percent min=-0.5 max=0.5 stepped=0
param PAT run unit=choice choice=Always|Transport|Note
param PAT fixed_velocity unit=choice choice=Off|On
param PAT velocity unit=percent min=0 max=1 stepped=0
param PAT likes_warp unit=choice choice=Off|On
param PAT play_mode unit=choice choice=Selector|Cycle
param PAT transpose_steps unit=number min=-14 max=14 stepped=1
param PAT transpose_octaves unit=number min=-4 max=4 stepped=1
param PAT free_phase unit=number min=-8388608 max=8388608 stepped=0
param PAT wobble unit=number min=-8388608 max=8388608 stepped=0
param PAT note_low unit=note min=0 max=127 stepped=1
param PAT note_high unit=note min=0 max=127 stepped=1
param PAT p1.enable unit=choice choice=Off|On
param PAT p1.solo unit=choice choice=Off|On
param PAT p1.mode unit=choice choice=Melody|Melody Mono|Chords|TB-Mono|TB-Glide|Drum|Progression|Modulation
