param HARM harm_p2_spread unit=percent min=0 max=1 stepped=0
param HARM harm_p2_width unit=percent min=0 max=1 stepped=0
param HARM harm_p2_depth unit=percent min=0 max=1 stepped=0
param HARM harm_p2_mode unit=choice choice=Notch|High-pass
param HARM harm_p2_active unit=choice choice=Off|On
param HARM harm_p3_harmonic unit=number min=0 max=101 stepped=1
