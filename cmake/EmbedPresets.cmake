# THE FACTORY PRESETS, EMBEDDED — every `.fpreset` under a folder, turned into a C++ source of byte
# arrays with their paths, so the plugin carries its presets and installs them on first open
# (`PresetStore::installFactoryFiles`, copy-when-missing). No runtime read of the repo: the bytes are in
# the binary.
#
# Two halves in one file, like GenerateTokens.cmake is one:
#
#   include(cmake/EmbedPresets.cmake)
#   feathers_embed_presets(<target> DIR <folder> FUNCTION <name>)
#       adds a generated .cpp to <target> defining
#       `std::span<const feathers::FactoryPresetFile> feathers::<name>()`.
#
#   cmake -DDIR=<folder> -DOUT=<file.cpp> -DFUNCTION=<name> -P EmbedPresets.cmake
#       the generator itself, which the build runs.
#
# ADDING A FILE REBUILDS: the configure-time glob is CONFIGURE_DEPENDS, so ninja re-checks it every
# build and re-runs CMake when a file appears or goes; every file is also a DEPENDS of the generation,
# so an edited one regenerates too. Hidden files and folders (a leading dot) are skipped, as the store
# skips them. The order is sorted, so the output is a function of the folder's contents alone.

if(CMAKE_SCRIPT_MODE_FILE)
	if(NOT DEFINED DIR OR NOT DEFINED OUT OR NOT DEFINED FUNCTION)
		message(FATAL_ERROR "DIR, OUT and FUNCTION are all required")
	endif()
	set(_files "")
	if(IS_DIRECTORY "${DIR}")
		file(GLOB_RECURSE _files RELATIVE "${DIR}" "${DIR}/*.fpreset")
	endif()
	list(FILTER _files EXCLUDE REGEX "(^|/)\\.")
	list(SORT _files)

	set(_arrays "")
	set(_entries "")
	set(_i 0)
	foreach(_rel IN LISTS _files)
		file(READ "${DIR}/${_rel}" _hex HEX)
		string(LENGTH "${_hex}" _hexlen)
		# THE PATH AS A C++ STRING: a backslash or a quote in a filename would otherwise end it.
		string(REPLACE "\\" "\\\\" _lit "${_rel}")
		string(REPLACE "\"" "\\\"" _lit "${_lit}")
		if(_hexlen EQUAL 0)
			# No zero-length arrays in C++: an empty file is an empty span.
			string(APPEND _entries "\tFactoryPresetFile { \"${_lit}\", {} },\n")
		else()
			string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
			string(APPEND _arrays "const uint8_t kFile${_i}[] = {\n\t${_bytes}\n};\n")
			string(APPEND _entries
			       "\tFactoryPresetFile { \"${_lit}\", std::span<const uint8_t> { kFile${_i}, sizeof(kFile${_i}) } },\n")
		endif()
		math(EXPR _i "${_i} + 1")
	endforeach()

	set(_body "")
	if(_i EQUAL 0)
		set(_body "std::span<const FactoryPresetFile> ${FUNCTION}() {\n\treturn {};\n}\n")
	else()
		set(_body "namespace {\n\n${_arrays}\nconst FactoryPresetFile kFiles[] = {\n${_entries}};\n\n} // namespace\n\n")
		string(APPEND _body "std::span<const FactoryPresetFile> ${FUNCTION}() {\n\treturn std::span<const FactoryPresetFile> { kFiles };\n}\n")
	endif()

	set(_text "// GENERATED by cmake/EmbedPresets.cmake from ${DIR} — do not edit; add a file to that folder.\n\n")
	string(APPEND _text "#include \"plugin/factory_presets.h\"\n\n#include <cstdint>\n#include <span>\n\n")
	string(APPEND _text "namespace feathers {\n\n${_body}\n} // namespace feathers\n")
	# WRITTEN ONLY WHEN IT CHANGED, so a re-run with the same folder recompiles nothing.
	if(EXISTS "${OUT}")
		file(READ "${OUT}" _old)
		if(_old STREQUAL _text)
			return()
		endif()
	endif()
	file(WRITE "${OUT}" "${_text}")
	return()
endif()

set(_feathers_embed_presets_script "${CMAKE_CURRENT_LIST_FILE}")

function(feathers_embed_presets target)
	cmake_parse_arguments(ARG "" "DIR;FUNCTION" "" ${ARGN})
	file(GLOB_RECURSE _abs CONFIGURE_DEPENDS "${ARG_DIR}/*.fpreset")
	set(_out "${CMAKE_CURRENT_BINARY_DIR}/generated/${ARG_FUNCTION}.cpp")
	# A REMOVED FILE REGENERATES TOO: removing one leaves every DEPENDS older than the output, so the
	# list itself goes on the command line (as a hash) and ninja re-runs a command that changed.
	string(MD5 _listHash "${_abs}")
	add_custom_command(
		OUTPUT "${_out}"
		COMMAND ${CMAKE_COMMAND} -DDIR=${ARG_DIR} -DOUT=${_out} -DFUNCTION=${ARG_FUNCTION} -DLIST=${_listHash}
		        -P "${_feathers_embed_presets_script}"
		DEPENDS "${_feathers_embed_presets_script}" ${_abs}
		COMMENT "Embedding the presets under ${ARG_DIR}"
		VERBATIM)
	target_sources(${target} PRIVATE "${_out}")
endfunction()
