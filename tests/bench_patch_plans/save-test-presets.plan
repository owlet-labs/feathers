baby_elf_bass_minus4 --preset presets/factory/Feathers/baby_elf_bass.fpreset --remove 4 --save test_-_Baby_Elf_Bass_without_Compressor --idle 0.05 --held 0.05 --tail 0.05
baby_elf_bass_minus5 --preset presets/factory/Feathers/baby_elf_bass.fpreset --remove 5 --save test_-_Baby_Elf_Bass_without_Bus_Utility --idle 0.05 --held 0.05 --tail 0.05
baby_elf_bass_none --preset presets/factory/Feathers/baby_elf_bass.fpreset --remove 0 --remove 1 --remove 2 --remove 3 --remove 4 --remove 5 --save test_-_Baby_Elf_Bass_engine_only_no_lane_devices --idle 0.05 --held 0.05 --tail 0.05
