<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Do NOT use @MACOSX_BUNDLE_EXECUTABLE@: it resolves empty for the CLAP
	     target, leaving CFBundleExecutable blank and making CFBundleLoadExecutable
	     fail to locate the binary. The value must be the file in Contents/MacOS/,
	     which is the target's LIBRARY_OUTPUT_NAME; clap-wrapper's wrap_clap.cmake
	     sets MACOSX_BUNDLE_BUNDLE_NAME to that same OUTPUT_NAME, and that key is
	     already proven to substitute here (CFBundleName below). So it tracks the
	     executable for every target this plist is applied to: "feathers" for
	     feathers_clap, "feathers-chain" for feathers-chain-plugin_clap. It used to be
	     hardcoded "feathers", which was only ever right for the first. -->
	<key>CFBundleExecutable</key>
	<string>@MACOSX_BUNDLE_BUNDLE_NAME@</string>
	<key>CFBundleIdentifier</key>
	<string>@MACOSX_BUNDLE_GUI_IDENTIFIER@</string>
	<key>CFBundleName</key>
	<string>@MACOSX_BUNDLE_BUNDLE_NAME@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>BNDL</string>
	<key>CFBundleShortVersionString</key>
	<string>@MACOSX_BUNDLE_SHORT_VERSION_STRING@</string>
	<key>CFBundleSignature</key>
	<string>FeAt</string>
	<key>CFBundleVersion</key>
	<string>@MACOSX_BUNDLE_BUNDLE_VERSION@</string>
	<key>CSResourcesFileMapped</key>
	<true/>
</dict>
</plist>
