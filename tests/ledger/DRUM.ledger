# Schema ledger for DRUM (backlog JF, split per device by NY.1). Checked by tests/test_state_ledger.cpp, whose banner says what each
# difference means: a new line is pasted, a harmless change is refreshed (FEATHERS_LEDGER_WRITE=1), a MEANING change is a new key or a schema bump.
device DRUM - schema=1
param DRUM drum_enabled unit=choice choice=Off|On
param DRUM drum_kind unit=choice choice=Kick|Membrane|Snare|Metal|Clap|String|Particle|Friction|Water|Sweep
param DRUM drum_note unit=note min=0 max=127 stepped=1
param DRUM drum_level unit=decibel min=-60 max=6 stepped=0
param DRUM drum_pan unit=percent min=-1 max=1 stepped=0
param DRUM drum_tune unit=number min=-48 max=48 stepped=0
param DRUM drum_decay unit=log_seconds min=-6.643856189774724 max=3.321928094887362 stepped=0
param DRUM drum_f_tone unit=percent min=0 max=1 stepped=0
param DRUM drum_f_noise unit=percent min=0 max=1 stepped=0
param DRUM drum_drive unit=percent min=0 max=1 stepped=0
param DRUM drum_trigger unit=choice choice=One-shot|Gate|Drone
param DRUM drum_voices unit=choice choice=1|2|4
param DRUM drum_release unit=log_seconds min=-6.643856189774724 max=1 stepped=0
param DRUM drum_bend unit=percent min=0 max=1 stepped=0
param DRUM drum_delay unit=number min=0 max=10 stepped=0
param DRUM drum_hp unit=log_hertz min=4.321928094887363 max=11 stepped=0
param DRUM drum_seed unit=number min=0 max=65535 stepped=1
param DRUM drum_zone unit=number min=0 max=1023 stepped=1
param DRUM drum_zone_offset unit=number min=0 max=1 stepped=0
