# THE KARPLUS-STRONG STARTER PRESETS (2026-10-31): five sounds that show the
# engine off, saved once through the browser's road (bench_patch --save) under $FEATHERS_PRESET_ROOT/Feathers/Plucks, tagged
# factory and pluck. Run from the repo root, --rounds 1, then copy $FEATHERS_PRESET_ROOT/Feathers/Plucks/*.fpreset to
# presets/factory/Feathers/Plucks/. Each sets both default sounds' string scalers (A at 0x0286.., B at 0x0296..), the engine-wide
# Pluck controls (0x00C0..), and the strip envelope's Sustain to full with a long Release (s0), so the string's own decay
# and Release shape the note rather than the envelope cutting it. Each is to be auditioned and kept, renamed or dropped.
nylon --engine pluck --param 0x0286=0.3 --param 0x0296=0.3 --param 0x0287=0.55 --param 0x0297=0.55 --param 0x0288=0.65 --param 0x0298=0.65 --param 0x0289=0.2 --param 0x0299=0.2 --param 0xC0=1.32 --param 0xC2=-2.0 --param 0xC3=0.35 --param 0xC5=0.12 --set s0:Env_Sustain=1 --set s0:Env_Release=-0.5 --category Plucks --tags factory,pluck --save Nylon_Pluck --idle 0.05 --held 0.05 --tail 0.05
harp --engine pluck --param 0x0286=0.85 --param 0x0296=0.85 --param 0x0287=0.8 --param 0x0297=0.8 --param 0x0288=0.3 --param 0x0298=0.3 --param 0x0289=0.05 --param 0x0299=0.05 --param 0xC0=3.0 --param 0xC1=0.6 --param 0xC2=0.585 --param 0xC4=0.1 --param 0xC5=0.2 --add FVERB --set 1:Featherverb_Mix=0.3 --set s0:Env_Sustain=1 --set s0:Env_Release=1.0 --category Plucks --tags factory,pluck --save Steel_Harp --idle 0.05 --held 0.05 --tail 0.05
bells --engine pluck --param 0x0286=0.75 --param 0x0296=0.75 --param 0x0287=0.85 --param 0x0297=0.85 --param 0x0288=0.25 --param 0x0298=0.25 --param 0x0289=0.0 --param 0x0299=0.0 --param 0x028A=0.9 --param 0x029A=0.9 --param 0xC0=2.585 --param 0xC2=0.0 --param 0xC5=0.25 --add FVERB --set 1:Featherverb_Mix=0.25 --set s0:Env_Sustain=1 --set s0:Env_Release=1.0 --category Plucks --tags factory,pluck --save Bell_Strings --idle 0.05 --held 0.05 --tail 0.05
bass --engine pluck --param 0x0286=0.15 --param 0x0296=0.15 --param 0x0287=0.3 --param 0x0297=0.3 --param 0x0288=0.7 --param 0x0298=0.7 --param 0x0289=0.35 --param 0x0299=0.35 --param 0xC0=-0.32 --param 0xC2=-4.06 --param 0xC3=0.3 --param 0xC5=0.0 --param 0x60=1 --set s0:Env_Sustain=1 --set s0:Env_Release=-2.0 --category Plucks --tags factory,pluck,bass --save Muted_Bass --idle 0.05 --held 0.05 --tail 0.05
walk --engine pluck --param 0x0010=120 --param 0x0020=700 --param 0x0030=0.5 --param 0x0042=0.6 --param 0xC0=2.0 --param 0xC5=0.15 --set s0:Env_Sustain=1 --set s0:Env_Release=0.5 --category Plucks --tags factory,pluck --save Terrain_Walk --idle 0.05 --held 0.05 --tail 0.05
