# Schema ledger for inject (backlog JF, split per device by NY.1). Checked by tests/test_state_ledger.cpp, whose banner says what each
# difference means: a new line is pasted, a harmless change is refreshed (FEATHERS_LEDGER_WRITE=1), a MEANING change is a new key or a schema bump.
device inject - schema=1
param inject inject_enabled unit=choice choice=Off|On
param inject inject_mix unit=percent min=0 max=1 stepped=0
param inject inject_gain unit=decibel min=-24 max=24 stepped=0
