# Schema ledger for MACROS8 (backlog JF, split per device by NY.1). Checked by tests/test_state_ledger.cpp, whose banner says what each
# difference means: a new line is pasted, a harmless change is refreshed (FEATHERS_LEDGER_WRITE=1), a MEANING change is a new key or a schema bump.
device MACROS8 - schema=1
param MACROS8 macro_1 unit=percent min=0 max=1 stepped=0
param MACROS8 macro_2 unit=percent min=0 max=1 stepped=0
param MACROS8 macro_3 unit=percent min=0 max=1 stepped=0
param MACROS8 macro_4 unit=percent min=0 max=1 stepped=0
param MACROS8 macro_5 unit=percent min=0 max=1 stepped=0
param MACROS8 macro_6 unit=percent min=0 max=1 stepped=0
param MACROS8 macro_7 unit=percent min=0 max=1 stepped=0
param MACROS8 macro_8 unit=percent min=0 max=1 stepped=0
param MACROS8 bipolar_1 unit=choice choice=Off|On
param MACROS8 bipolar_2 unit=choice choice=Off|On
param MACROS8 bipolar_3 unit=choice choice=Off|On
param MACROS8 bipolar_4 unit=choice choice=Off|On
param MACROS8 bipolar_5 unit=choice choice=Off|On
param MACROS8 bipolar_6 unit=choice choice=Off|On
param MACROS8 bipolar_7 unit=choice choice=Off|On
param MACROS8 bipolar_8 unit=choice choice=Off|On
param MACROS8 type_1 unit=choice choice=Knob|Latch|Momentary
param MACROS8 type_2 unit=choice choice=Knob|Latch|Momentary
param MACROS8 type_3 unit=choice choice=Knob|Latch|Momentary
param MACROS8 type_4 unit=choice choice=Knob|Latch|Momentary
param MACROS8 type_5 unit=choice choice=Knob|Latch|Momentary
param MACROS8 type_6 unit=choice choice=Knob|Latch|Momentary
param MACROS8 type_7 unit=choice choice=Knob|Latch|Momentary
param MACROS8 type_8 unit=choice choice=Knob|Latch|Momentary
param MACROS8 enabled unit=choice choice=Off|On
out MACROS8 macro_1 bipolar=1
out MACROS8 macro_2 bipolar=1
out MACROS8 macro_3 bipolar=1
out MACROS8 macro_4 bipolar=1
out MACROS8 macro_5 bipolar=1
out MACROS8 macro_6 bipolar=1
out MACROS8 macro_7 bipolar=1
out MACROS8 macro_8 bipolar=1
