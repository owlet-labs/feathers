# Schema ledger for RACK (backlog JF, split per device by NY.1). Checked by tests/test_state_ledger.cpp, whose banner says what each
# difference means: a new line is pasted, a harmless change is refreshed (FEATHERS_LEDGER_WRITE=1), a MEANING change is a new key or a schema bump.
device RACK - schema=1
param RACK rack_enabled unit=choice choice=Off|On
param RACK rack_mix unit=percent min=0 max=1 stepped=0
param RACK rack_gain unit=fader min=0 max=1 stepped=0
param RACK macro_1 unit=percent min=0 max=1 stepped=0
param RACK macro_2 unit=percent min=0 max=1 stepped=0
param RACK macro_3 unit=percent min=0 max=1 stepped=0
param RACK macro_4 unit=percent min=0 max=1 stepped=0
param RACK macro_5 unit=percent min=0 max=1 stepped=0
param RACK macro_6 unit=percent min=0 max=1 stepped=0
param RACK macro_7 unit=percent min=0 max=1 stepped=0
param RACK macro_8 unit=percent min=0 max=1 stepped=0
param RACK rack_mode unit=choice choice=Parallel|Select|Blend|Mid/Side|Left/Right|Bands
param RACK rack_position unit=percent min=0 max=1 stepped=0
param RACK rack_unused unit=choice choice=Ring out|Stop
param RACK rack_bands unit=choice choice=2|3|5
param RACK rack_cut_1 unit=log_hertz min=4.321928094887363 max=14.287712379549449 stepped=0
param RACK rack_cut_2 unit=log_hertz min=4.321928094887363 max=14.287712379549449 stepped=0
