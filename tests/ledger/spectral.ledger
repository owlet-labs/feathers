param spectral spectral_fshift_low unit=number min=-36 max=36 stepped=0
param spectral spectral_fshift_high unit=number min=-36 max=36 stepped=0
param spectral spectral_fshift_crossover unit=log_hertz min=6.643856189774724 max=12.965784284662087 stepped=0
