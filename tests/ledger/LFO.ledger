param LFO t4_skew_pre_trough unit=percent min=0 max=1 stepped=0
param LFO t4_seed unit=number min=0 max=999 stepped=1
param LFO t4_time_base unit=choice choice=Hz|1/64|1/64.|1/64T|1/32|1/32.|1/32T|1/16|1/16.|1/16T|1/8|1/8.|1/8T|1/4|1/4.|1/4T|1/2|1/2.|1/2T|1 bar|1 bar.|1 barT|2 bar|2 bar.|2 barT|4 bar|4 bar.|4 barT|Note
param LFO t4_rate unit=log_multiple min=-11 max=3.321928024291992 stepped=0
param LFO t4_smoothing unit=log_seconds min=-11 max=0 stepped=0
param LFO t4_mode unit=choice choice=Gate|Loop|Once|Free|LFO Retrig
param LFO t4_phase unit=percent min=0 max=1 stepped=0
param LFO t4_ping_pong unit=choice choice=Off|On
param LFO t4_bipolar unit=choice choice=Off|On
param LFO t4_enabled unit=choice choice=Off|On
param LFO t4_amount unit=percent min=-1 max=1 stepped=0
param LFO t4_poly unit=choice choice=Off|On
param LFO t4_smooth_carry unit=choice choice=Off|On
param LFO t4_trig unit=percent min=0 max=1 stepped=0
param LFO t4_notes_trig unit=choice choice=Off|On
param LFO t4_stereo_phase unit=degrees min=0 max=3.141592653589793 stepped=0
param LFO view_tab unit=number min=0 max=3 stepped=1
out LFO lfo bipolar=1
out LFO lfo_2 bipolar=1
out LFO lfo_3 bipolar=1
out LFO lfo_4 bipolar=1
